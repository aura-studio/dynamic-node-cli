{
  "name": "dynamic-node-cli",
  "version": "0.0.0",
  "description": "dynamic-node build tool",
  "type": "module",
  "bin": {
    "dynamic-node": "./src/main.js",
    "dynamic-node-cli": "./src/main.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "check": "node --check src/main.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.821.0",
    "commander": "^12.1.0",
    "esbuild": "^0.25.5",
    "js-yaml": "^4.1.0",
    "yazl": "^3.3.1"
  }
}
