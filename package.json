{
  "name": "dynamic-node-cli",
  "version": "0.0.0",
  "description": "dynamic-node build tool",
  "type": "module",
  "bin": {
    "dynamic-node": "./src/main.js",
    "dynamic-node-cli": "./src/main.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test test/**/*.test.js",
    "test:examples": "node examples/scripts/99-run-all-local.js",
    "test:examples:s3": "node examples/scripts/99-run-all-with-s3.js",
    "test:examples:s3:docker": "node examples/scripts/99-run-all-docker-s3.js",
    "test:all": "npm run check && npm test && npm run test:examples"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.821.0",
    "adm-zip": "^0.5.16",
    "commander": "^12.1.0",
    "esbuild": "^0.25.5",
    "js-yaml": "^4.1.0",
    "yazl": "^3.3.1"
  }
}
